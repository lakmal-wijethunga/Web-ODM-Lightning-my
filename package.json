{
  "name": "webodm-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WebODM Lightning alternative: publish drone survey results as private, streamable client links on GitHub Pages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
