{
  "name": "webodm-backup-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A WebODM Lightning-style dashboard that archives WebODM task backups in GitHub Releases and serves them from GitHub Pages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "upload": "node --env-file-if-exists=uploader/.env uploader/server.js",
    "manifest": "node --env-file-if-exists=uploader/.env uploader/bin/rebuild-manifest.js",
    "test": "node uploader/bin/selftest.js"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  }
}
