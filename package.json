    "auth:google": "node tools/auth-google.mjs"
  },
  "dependencies": {
    "copc": "^0.0.9",
    "ol": "^10.10.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
