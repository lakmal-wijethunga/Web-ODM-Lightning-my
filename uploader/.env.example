# Copy this file to `uploader/.env` and fill in your token.
# `uploader/.env` is gitignored — it must never be committed.
#
# Create a FINE-GRAINED personal access token:
#   https://github.com/settings/personal-access-tokens/new
#   Repository access : Only select repositories -> Web-ODM-Lightning-my
#   Permissions       : Repository permissions -> Contents -> Read and write
#
# That is the only permission needed. Do not use a classic token with `repo`
# scope: it would grant write access to every repository you own.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Auto-detected from `git remote get-url origin` when omitted.
# GITHUB_REPO=lakmal-wijethunga/Web-ODM-Lightning-my

# Optional. Port for the local uploader UI.
# PORT=4000
