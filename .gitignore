# dependencies
node_modules/

# viewer build output (built by CI, deployed to Pages)
dist/

# local conversion scratch space — these are multi-GB
.work/
tmp/

# secrets — NEVER commit these
.env
.env.local
*service-account*.json
gcp-*.json
credentials.json
client_secret*.json

# raw WebODM task data should never land in the repo
*.zip
*.tif
*.laz
*.las
*.obj
*.mtl

# ...except the small bundled demo COG, which is committed on purpose so the
# viewer has something to render before your first real publish.
# Delete projects/demo/ once you have a real project.
!projects/demo/orthophoto.tif

# logs / os cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db
